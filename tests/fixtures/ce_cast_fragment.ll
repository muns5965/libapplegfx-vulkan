; ModuleID = 'ce_cast_fragment'
target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
target triple = "air64-apple-macosx15.6.0"

@llvm.global_ctors = appending global [0 x { i32, ptr, ptr }] zeroinitializer

@__ce_g = internal addrspace(2) constant i32 5, align 4

define <4 x float> @CeCastFragment(<4 x float> %0, <4 x float> %1) {
entry:
  ; constant-expression casts of the ADDRESS of a module global (CST_CODE_CE_CAST records that LLVM cannot fold; census X03):
  ;   addrspacecast of a global to another address space: the translator materialises no SPIR-V variable for AIR globals, so no OpUndef pointer placeholder is wanted
  ;   ptrtoint of a global: an address the SPIR-V module cannot express, so the value stays an (i64) OpUndef placeholder
  call void @use_ptr(ptr addrspace(1) addrspacecast (ptr addrspace(2) @__ce_g to ptr addrspace(1)))
  call void @use_i64(i64 ptrtoint (ptr addrspace(2) @__ce_g to i64))
  ret <4 x float> %1
}

declare void @use_ptr(ptr addrspace(1))
declare void @use_i64(i64)

!llvm.module.flags = !{!0, !1, !2, !3, !4, !5, !6, !7, !8}
!air.version = !{!9}
!llvm.ident = !{!10}
